generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  HR_OFFICER
  HR
  PAYROLL_OFFICER
  ACCOUNTANT
  FINANCE
  DEPARTMENT_MANAGER
  OPERATIONS_MANAGER
  EMPLOYEE
  AUDITOR
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  RESIGNED
  TERMINATED
  SUSPENDED
  EXPIRED_CONTRACT
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum BiometricConnectionType {
  TCP_IP
  ADMS_PUSH
  BIOTIME_API
  BIOTIME_DATABASE
  MANUAL_IMPORT
}

enum BiometricDeviceStatus {
  ACTIVE
  INACTIVE
}

enum BiometricConnectionStatus {
  NOT_TESTED
  CONNECTED
  FAILED
}

enum BiometricProcessingStatus {
  RAW
  PROCESSED
  UNMATCHED
  ERROR
  DUPLICATE
}

enum BiometricPunchType {
  CHECK_IN
  CHECK_OUT
  BREAK_OUT
  BREAK_IN
  OVERTIME_IN
  OVERTIME_OUT
  UNKNOWN
}

enum AttendanceApprovalStatus {
  DRAFT
  PENDING_MANAGER_APPROVAL
  PENDING_HR_MANAGER_APPROVAL
  FINAL_APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
  MATERNITY
  PATERNITY
  HAJJ
  MARRIAGE
  BEREAVEMENT
  COMPENSATORY
  CUSTOM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  EXPORTED
}

enum WorkflowStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_OM
  PENDING_HR_MANAGER
  PENDING_FINANCE
  PENDING_ADMIN
  RESIGNATION_APPROVED
  EXIT_CLEARANCE_IN_PROGRESS
  FINAL_SETTLEMENT_PENDING
  EXIT_COMPLETED
  FINAL_APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  CANCELLED
  PUBLISHED
  CLOSED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(EMPLOYEE)
  employeeId          String?              @unique
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  notifications       Notification[]
  portalStatus        String               @default("ACTIVE")
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  firstLoginRequired  Boolean              @default(false)
  passwordResetRequired Boolean            @default(false)
  forcePasswordChange Boolean              @default(false)
  passwordChangedAt   DateTime             @default(now())
  lastPasswordResetBy String?
  lastPasswordResetAt DateTime?
  passwordHistory     Json?
  sessions            UserSession[]
  resetTokens         PasswordResetToken[]
  portalOtps          PortalOtp[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  userId    String?
  result    String
  reason    String?
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenId    String    @unique
  device     String?
  ipAddress  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PortalOtp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  purpose   String
  otpHash   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model FormDraft {
  id        String   @id @default(cuid())
  userId    String?
  module    String
  draftKey  String
  data      Json
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, draftKey])
}

model CompanyProfile {
  id                  String   @id @default("default")
  companyName         String
  companyNameArabic   String?
  registrationNumber  String?
  vatNumber           String?
  address             String?
  city                String?
  country             String?  @default("Saudi Arabia")
  phone               String?
  fax                 String?
  email               String?
  website             String?
  gosiNumber          String?
  qiwaReference       String?
  bankDetails         String?
  authorizedSignatory String?
  companyStampDataUrl String?
  letterheadSettings  Json?
  logoDataUrl         String?
  logoVersion         Int      @default(1)
  documentCompanyMode String   @default("CURRENT")
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Department {
  id                String             @id @default(cuid())
  name              String             @unique
  code              String             @unique
  employees         Employee[]
  managedBy         Employee[]         @relation("DepartmentManager")
  approvalWorkflows ApprovalWorkflow[]
  biometricDevices  BiometricDevice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Employee {
  id                           String                        @id @default(cuid())
  employeeCode                 String                        @unique
  nationalId                   String                        @unique
  firstName                    String
  lastName                     String
  fullNameArabic               String?
  nationality                  String?
  gender                       String?
  dateOfBirth                  DateTime?
  maritalStatus                String?
  religion                     String?
  email                        String                        @unique
  companyEmail                 String?
  phone                        String?
  emergencyContact             String?
  address                      String?
  passportNumber               String?
  iqamaExpiryDate              DateTime?
  passportExpiryDate           DateTime?
  visaDetails                  String?
  visaExpiryDate               DateTime?
  workPermitDetails            String?
  gosiNumber                   String?
  qiwaReference                String?
  biometricId                  String?
  deviceUserId                 String?
  cardNumber                   String?
  fingerprintEnrollmentStatus  String?
  faceEnrollmentStatus         String?
  deviceAssignment             String?
  biometricActive              Boolean                       @default(true)
  bankName                     String?
  iban                         String?
  jobTitle                     String
  branch                       String?
  location                     String?
  managerId                    String?
  manager                      Employee?                     @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports                Employee[]                    @relation("EmployeeManager")
  employeeType                 String?
  contractType                 String?
  contractExpiryDate           DateTime?
  probationStartDate           DateTime?
  probationEndDate             DateTime?
  medicalInsuranceExpiryDate   DateTime?
  drivingLicenseExpiryDate     DateTime?
  photoUrl                     String?
  profilePhotoPath             String?                       @map("profile_photo_path")
  profilePhotoFileName         String?                       @map("profile_photo_file_name")
  profilePhotoMimeType         String?                       @map("profile_photo_mime_type")
  profilePhotoSize             Int?                          @map("profile_photo_size")
  profilePhotoUploadedBy       String?                       @map("profile_photo_uploaded_by")
  profilePhotoUploadedAt       DateTime?                     @map("profile_photo_uploaded_at")
  profilePhotoStatus           String                        @default("ACTIVE") @map("profile_photo_status")
  joiningDate                  DateTime
  status                       EmploymentStatus              @default(ACTIVE)
  basicSalary                  Decimal                       @db.Decimal(12, 2)
  housingAllowance             Decimal                       @default(0) @db.Decimal(12, 2)
  transportAllowance           Decimal                       @default(0) @db.Decimal(12, 2)
  otherAllowance               Decimal                       @default(0) @db.Decimal(12, 2)
  leaveBalance                 Int                           @default(21)
  departmentId                 String
  department                   Department                    @relation(fields: [departmentId], references: [id])
  managedDepartments           Department[]                  @relation("DepartmentManager")
  user                         User?
  attendance                   Attendance[]
  biometricMappings            BiometricEmployeeMapping[]
  rawBiometricLogs             BiometricDeviceLog[]
  attendanceRecords            AttendanceRecord[]
  attendanceAdjustmentRequests AttendanceAdjustmentRequest[]
  leaves                       LeaveRequest[]
  managedLeaveRequests         LeaveRequest[]                @relation("LeaveManager")
  notifications                Notification[]
  payrollItems                 PayrollItem[]
  uploadedPayrollItems         PayrollUploadItem[]
  uploadedLeaveBalances        LeaveBalanceUploadItem[]
  importRows                   EmployeeImportRow[]
  groupMemberships             GroupMember[]
  documents                    EmployeeDocument[]
  businessTrips                BusinessTripRequest[]
  tripExpenseClaims            TripExpenseClaim[]
  loanRequests                 EmployeeLoanRequest[]
  performanceAppraisals        PerformanceAppraisal[]
  manualAppraisals             ManualAppraisal[]
  salaryHistory                EmployeeSalaryHistory[]
  resignationRequests          ResignationRequest[]
  exitClearanceItems           ExitClearanceItem[]
  finalSettlements             FinalSettlement[]
  ticketRequests               TicketRequest[]
  pettyCashRequests            PettyCashRequest[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  archivedAt                   DateTime?
}

model Attendance {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  workDate      DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  lateMinutes   Int              @default(0)
  overtimeHours Decimal          @default(0) @db.Decimal(8, 2)
  status        AttendanceStatus @default(PRESENT)
  source        String           @default("MANUAL")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, workDate])
}

model BiometricDevice {
  id                  String                     @id @default(cuid())
  deviceName          String
  deviceCode          String                     @unique
  brand               String                     @default("ZKTeco")
  model               String?
  serialNumber        String?
  ipAddress           String?
  port                Int?
  connectionType      BiometricConnectionType
  deviceLocation      String?
  branch              String?
  departmentId        String?
  department          Department?                @relation(fields: [departmentId], references: [id])
  timezone            String                     @default("Asia/Riyadh")
  status              BiometricDeviceStatus      @default(ACTIVE)
  lastSyncAt          DateTime?
  connectionStatus    BiometricConnectionStatus  @default(NOT_TESTED)
  syncIntervalMinutes Int                        @default(15)
  remarks             String?
  secureConfig        Json?
  logs                BiometricDeviceLog[]
  mappings            BiometricEmployeeMapping[]
  syncHistory         BiometricSyncHistory[]
  errorLogs           BiometricErrorLog[]
  attendanceRecords   AttendanceRecord[]
  createdBy           String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  archivedAt          DateTime?
}

model BiometricDeviceLog {
  id                 String                    @id @default(cuid())
  deviceId           String
  device             BiometricDevice           @relation(fields: [deviceId], references: [id])
  deviceName         String
  deviceUserId       String
  employeeId         String?
  employee           Employee?                 @relation(fields: [employeeId], references: [id])
  employeeName       String?
  punchDate          DateTime
  punchTime          DateTime
  punchType          BiometricPunchType        @default(UNKNOWN)
  verificationType   String?
  workCode           String?
  deviceSerialNumber String?
  deviceIp           String?
  syncAt             DateTime                  @default(now())
  rawLogReference    String
  rawPayload         Json?
  processingStatus   BiometricProcessingStatus @default(RAW)
  errorMessage       String?
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord?         @relation(fields: [attendanceRecordId], references: [id])
  createdAt          DateTime                  @default(now())

  @@unique([deviceId, rawLogReference])
  @@index([deviceUserId, punchDate])
  @@index([employeeId, punchDate])
}

model BiometricEmployeeMapping {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id])
  deviceId     String?
  device       BiometricDevice? @relation(fields: [deviceId], references: [id])
  biometricId  String?
  deviceUserId String
  cardNumber   String?
  syncStatus   String           @default("PENDING")
  lastPunchAt  DateTime?
  active       Boolean          @default(true)
  remarks      String?
  createdBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  archivedAt   DateTime?

  @@unique([deviceId, deviceUserId])
  @@index([employeeId])
}

model AttendanceRecord {
  id                 String                        @id @default(cuid())
  employeeId         String
  employee           Employee                      @relation(fields: [employeeId], references: [id])
  workDate           DateTime
  shift              String?
  firstIn            DateTime?
  lastOut            DateTime?
  workingHours       Decimal                       @default(0) @db.Decimal(8, 2)
  lateMinutes        Int                           @default(0)
  earlyOutMinutes    Int                           @default(0)
  overtimeHours      Decimal                       @default(0) @db.Decimal(8, 2)
  attendanceStatus   String                        @default("PRESENT")
  deviceId           String?
  device             BiometricDevice?              @relation(fields: [deviceId], references: [id])
  source             String                        @default("BIOMETRIC")
  approvalStatus     AttendanceApprovalStatus      @default(DRAFT)
  rawLogs            BiometricDeviceLog[]
  adjustmentRequests AttendanceAdjustmentRequest[]
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model AttendanceAdjustmentRequest {
  id                 String                   @id @default(cuid())
  requestNumber      String                   @unique @default(cuid())
  employeeId         String
  employee           Employee                 @relation(fields: [employeeId], references: [id])
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord?        @relation(fields: [attendanceRecordId], references: [id])
  reasonType         String
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  requestedShift     String?
  comments           String?
  workflowStage      String                   @default("PENDING_MANAGER_APPROVAL")
  status             AttendanceApprovalStatus @default(PENDING_MANAGER_APPROVAL)
  managerId          String?
  hrApproverId       String?
  decidedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model BiometricSyncHistory {
  id                String                   @id @default(cuid())
  deviceId          String?
  device            BiometricDevice?         @relation(fields: [deviceId], references: [id])
  connectionType    BiometricConnectionType?
  startedAt         DateTime                 @default(now())
  finishedAt        DateTime?
  status            String                   @default("RUNNING")
  pulledCount       Int                      @default(0)
  processedCount    Int                      @default(0)
  unmatchedCount    Int                      @default(0)
  duplicateCount    Int                      @default(0)
  lastTransactionId String?
  errorMessage      String?
  triggeredBy       String?
}

model BiometricErrorLog {
  id        String           @id @default(cuid())
  deviceId  String?
  device    BiometricDevice? @relation(fields: [deviceId], references: [id])
  action    String
  message   String
  payload   Json?
  createdAt DateTime         @default(now())
}

model LeaveRequest {
  id                        String            @id @default(cuid())
  requestNumber             String            @unique @default(cuid())
  employeeId                String
  employee                  Employee          @relation(fields: [employeeId], references: [id])
  managerId                 String?
  manager                   Employee?         @relation("LeaveManager", fields: [managerId], references: [id])
  omApproverId              String?
  hrApproverId              String?
  type                      LeaveType
  startDate                 DateTime
  endDate                   DateTime
  days                      Int
  reason                    String?
  contactNumber             String?
  leaveAddress              String?
  emergencyContact          String?
  attachmentName            String?
  destinationCountry         String?
  destinationCity            String?
  mobileWhileOnLeave         String?
  personalEmailWhileOnLeave  String?
  emergencyContactName       String?
  emergencyContactNumber     String?
  emergencyContactRelationship String?
  lastWorkingDay             DateTime?
  returnToWorkDate           DateTime?
  relieverId                 String?
  relieverName               String?
  relieverEmployeeCode       String?
  relieverDepartment         String?
  relieverDesignation        String?
  relieverManager            String?
  handoverRequired           Boolean           @default(false)
  handoverDetails            String?
  handoverAttachment         String?
  relieverAcknowledgementStatus String           @default("PENDING")
  annualVacationRemarks      String?
  attachments                Json?
  ticketRequests             TicketRequest[]
  pettyCashRequests          PettyCashRequest[]
  availableBalanceAtRequest Int?
  workflowStage             String            @default("PENDING_MANAGER_APPROVAL")
  comments                  String?
  status                    ApprovalStatus    @default(PENDING)
  approvedBy                String?
  decidedAt                 DateTime?
  approvalHistory           ApprovalHistory[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model TicketRequest {
  id                      String         @id @default(cuid())
  requestNumber           String         @unique
  leaveRequestId          String
  leaveRequest            LeaveRequest   @relation(fields: [leaveRequestId], references: [id])
  employeeId              String
  employee                Employee       @relation(fields: [employeeId], references: [id])
  departureCountry        String?
  departureCity           String?
  arrivalCountry          String
  arrivalCity             String
  preferredDepartureDate  DateTime
  preferredReturnDate     DateTime?
  preferredAirline        String?
  preferredFlightTime     String?
  passportNumber          String?
  passportExpiryDate      DateTime?
  iqamaNumber             String?
  iqamaExpiryDate         DateTime?
  visaRequirement         String?
  travelClass             String?
  ticketType              String         @default("RETURN")
  familyTicketRequired    Boolean        @default(false)
  familyMemberDetails     Json?
  estimatedTicketCost     Decimal        @default(0) @db.Decimal(12, 2)
  costCenter              String?
  projectCode             String?
  remarks                 String?
  attachments             Json?
  bookingReference        String?
  ticketCopyReference     String?
  currentApprover         String?
  status                  WorkflowStatus @default(DRAFT)
  approvalTimeline        Json?
  createdBy               String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  archivedAt              DateTime?
}

model PettyCashRequest {
  id                     String         @id @default(cuid())
  requestNumber          String         @unique
  employeeId             String
  employee               Employee       @relation(fields: [employeeId], references: [id])
  requestDate            DateTime       @default(now())
  requestType            String
  purpose                String
  businessTripReference  String?
  linkedLeaveRequestId   String?
  linkedLeaveRequest     LeaveRequest?  @relation(fields: [linkedLeaveRequestId], references: [id])
  costCenter             String?
  projectCode            String?
  requestedAmount        Decimal        @db.Decimal(12, 2)
  approvedAmount         Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount             Decimal        @default(0) @db.Decimal(12, 2)
  settledAmount          Decimal        @default(0) @db.Decimal(12, 2)
  outstandingAmount      Decimal        @default(0) @db.Decimal(12, 2)
  currency               String         @default("SAR")
  exchangeRate           Decimal        @default(1) @db.Decimal(12, 4)
  amountSar              Decimal        @db.Decimal(12, 2)
  requiredDate           DateTime
  paymentMethod          String?
  bankName               String?
  iban                   String?
  cashCollectionLocation String?
  detailedJustification  String
  remarks                String?
  attachments            Json?
  settlementAttachments  Json?
  settlementDueDate      DateTime?
  paidAt                 DateTime?
  currentApprover        String?
  status                 WorkflowStatus @default(DRAFT)
  paymentStatus          String         @default("UNPAID")
  settlementStatus       String         @default("NOT_REQUIRED")
  approvalTimeline       Json?
  paymentHistory         Json?
  settlementHistory      Json?
  createdBy              String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  archivedAt             DateTime?
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NumberSeries {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  prefix         String
  separator      String   @default("-")
  padding        Int      @default(5)
  nextNumber     Int      @default(1)
  startNumber    Int      @default(1)
  resetFrequency String   @default("NEVER")
  lastResetKey   String?
  active         Boolean  @default(true)
  remarks        String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?
}

model EmailTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  subject   String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id                 String    @id @default(cuid())
  notificationKey    String    @unique
  recipient          String
  subject            String
  templateCode       String
  leaveRequestNumber String?
  status             String    @default("PENDING")
  sentAt             DateTime?
  failureReason      String?
  retryCount         Int       @default(0)
  payload            Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PayrollRun {
  id         String        @id @default(cuid())
  month      Int
  year       Int
  status     PayrollStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  items      PayrollItem[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([month, year])
}

model PayrollItem {
  id                 String     @id @default(cuid())
  payrollRunId       String
  payrollRun         PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId         String
  employee           Employee   @relation(fields: [employeeId], references: [id])
  basicSalary        Decimal    @db.Decimal(12, 2)
  housingAllowance   Decimal    @db.Decimal(12, 2)
  transportAllowance Decimal    @db.Decimal(12, 2)
  otherAllowance     Decimal    @db.Decimal(12, 2)
  overtime           Decimal    @default(0) @db.Decimal(12, 2)
  absenceDeduction   Decimal    @default(0) @db.Decimal(12, 2)
  loanDeduction      Decimal    @default(0) @db.Decimal(12, 2)
  gosiDeduction      Decimal    @default(0) @db.Decimal(12, 2)
  netSalary          Decimal    @db.Decimal(12, 2)

  @@unique([payrollRunId, employeeId])
}

model PayrollUploadBatch {
  id               String              @id @default(cuid())
  month            Int
  year             Int
  company          String
  branch           String?
  departmentId     String?
  payrollType      String
  paymentDate      DateTime
  status           String              @default("DRAFT")
  originalFileName String?
  revisionNumber   Int                 @default(1)
  submittedAt      DateTime?
  approvedAt       DateTime?
  publishedAt      DateTime?
  lockedAt         DateTime?
  approvalComments String?
  approvalHistory  Json?
  items            PayrollUploadItem[]
  createdBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  archivedAt       DateTime?

  @@unique([month, year, company, branch, payrollType, revisionNumber])
}

model PayrollUploadItem {
  id                   String             @id @default(cuid())
  batchId              String
  batch                PayrollUploadBatch @relation(fields: [batchId], references: [id])
  employeeId           String
  employee             Employee           @relation(fields: [employeeId], references: [id])
  employeeCode         String
  employeeName         String
  department           String?
  jobTitle             String?
  payrollPeriod        String
  basicSalary          Decimal            @db.Decimal(12, 2)
  housingAllowance     Decimal            @default(0) @db.Decimal(12, 2)
  transportAllowance   Decimal            @default(0) @db.Decimal(12, 2)
  otherAllowance       Decimal            @default(0) @db.Decimal(12, 2)
  overtime             Decimal            @default(0) @db.Decimal(12, 2)
  bonus                Decimal            @default(0) @db.Decimal(12, 2)
  commission           Decimal            @default(0) @db.Decimal(12, 2)
  leaveDeduction       Decimal            @default(0) @db.Decimal(12, 2)
  unpaidLeaveDeduction Decimal            @default(0) @db.Decimal(12, 2)
  loanDeduction        Decimal            @default(0) @db.Decimal(12, 2)
  advanceDeduction     Decimal            @default(0) @db.Decimal(12, 2)
  gosiDeduction        Decimal            @default(0) @db.Decimal(12, 2)
  otherDeduction       Decimal            @default(0) @db.Decimal(12, 2)
  grossSalary          Decimal            @db.Decimal(12, 2)
  totalDeduction       Decimal            @db.Decimal(12, 2)
  netSalary            Decimal            @db.Decimal(12, 2)
  bankName             String?
  iban                 String?
  paymentDate          DateTime
  remarks              String?
  documentReference    String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([batchId, employeeId])
}

model LeaveBalanceUploadBatch {
  id               String                   @id @default(cuid())
  company          String
  branch           String?
  leaveYear        Int
  leaveType        LeaveType
